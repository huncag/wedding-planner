# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Copy this file to `.env.local` and fill in the two values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Auth gate — the planner requires a Supabase session by default whenever the
# two values above are set. `/rsvp` and `/login` always stay public.
# Set this to "false" only for local design work without the auth gate.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_ENABLED=true
